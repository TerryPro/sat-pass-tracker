# 前端配置模板：复制为 frontend/.env 后按需修改（.env 不入库）
# 修改后需重启 vite 开发服务器生效。

# 开发服务器端口
VITE_DEV_PORT=5173

# 开发代理目标（后端地址，/api 与 /socket.io 都代理到这里）
VITE_API_PROXY_TARGET=http://localhost:8765

# 后端设置加载失败时的回退默认参数（可选）
VITE_DEFAULT_LAT=39.9042
VITE_DEFAULT_LON=116.4074
VITE_DEFAULT_ALT=44
VITE_DEFAULT_HOURS=48
VITE_DEFAULT_SAMPLE_INTERVAL=60
VITE_DEFAULT_HORIZON=0
