# 后端配置模板：复制为 backend/.env 后按需修改（.env 不入库）
# 真实环境变量优先于 .env 文件；所有键均可省略，省略时用代码内默认值。

# 服务监听地址与端口
GS_HOST=0.0.0.0
GS_PORT=8765

# 默认地面站坐标（首次启动 / 设置缺失时的回退）
GS_DEFAULT_LAT=39.9042
GS_DEFAULT_LON=116.4074
GS_DEFAULT_ALT_M=44.0

# 内置 ON80DD 站点坐标（Maidenhead 格网中心，北京西北）
GS_ON80DD_LAT=40.1458
GS_ON80DD_LON=116.2917
GS_ON80DD_ALT_M=44.0

# 运行时数据目录（settings.json / tles.json / satellite_info.json），留空用默认 backend/data
# GS_DATA_DIR=

# CORS 允许来源（逗号分隔；默认仅本地前端 5173 端口；* 表示任意来源并自动关闭携带凭据）
# GS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
